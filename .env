# ─────────────────────────────────────────────────────────
# MyHabits — Environment Variables (example)
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` with real values to source control.
# ─────────────────────────────────────────────────────────

# ─────── MongoDB (used only by the /api/[[...path]] stub route) ───────
# For local dev you can use a local MongoDB or MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017
DB_NAME=myhabits

# ─────── Public base URL of your deployed app ───────
# Used for building absolute URLs in a few places. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────── CORS origins ───────
# Comma-separated list of allowed origins, or "*" to allow all.
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────
# Firebase Web SDK configuration
# Get these values from: Firebase Console -> Project Settings -> General
# -> "Your apps" -> select your web app -> "SDK setup and configuration"
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA2bLWgGBrObArgirvzfV31IbBVY_w7P2w
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=habit-tracker-6b857.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=habit-tracker-6b857
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=habit-tracker-6b857.firebasestorage.app
